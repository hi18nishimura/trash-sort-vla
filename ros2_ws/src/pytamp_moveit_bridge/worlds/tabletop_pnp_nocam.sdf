<?xml version="1.0"?>
<!-- Integrated YOLO pick-and-place world: table + a cup + a ball (YOLO-COCO
     detectable) + a tray (place target) + an overhead RGBD camera. The Panda is
     spawned separately by the launch. set_pose service (UserCommands) is used by
     grasp_manager for kinematic grasp-attach. -->
<sdf version="1.11">
  <world name="tabletop">
    <!-- Raise bullet's constraint-solver iterations (default 50). The
         DetachableJoint grasp weld under bullet-featherstone is a violable
         constraint, and the finger contacts against the welded cup are not
         collision-filtered (upstream gz-physics #640 TODO) — with default
         iterations the per-step constraint violation accumulated enough that a
         welded cup drifted 25 mm mid-carry and was flung metres at detach.
         More iterations shrink the violation each step. (//physics/bullet/
         solver/iters requires SDF spec 1.11 — hence the version bump.) -->
    <physics name="default" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <bullet>
        <solver>
          <iters>200</iters>
        </solver>
      </bullet>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun"><cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose><diffuse>1 1 1 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction></light>
    <light type="point" name="fill"><pose>0.5 0 1.4 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse><attenuation><range>6</range></attenuation></light>

    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="c"><geometry><plane><normal>0 0 1</normal></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
    </link></model>

    <model name="table"><static>true</static><pose>0.5 0 0.40 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.8 0.8 0.02</size></box></geometry><surface><friction>
        <!-- LOW friction so an off-centre finger can SLIDE the cup toward the pinch
             centre. With the support gripping as hard as the fingers, the cup braced
             against the table and the contact back-drove the closing finger outward
             (fingers ended at 0.041-0.042 on a 0.022 close). bullet combines pair
             friction by multiplication: cup(3.0) x table(0.4) = 1.2 support grip vs
             cup(3.0) x finger(1.0 default) = 3.0 finger grip. -->
        <bullet><friction>0.4</friction><friction2>0.4</friction2></bullet>
      </friction></surface></collision>
      <visual name="v"><geometry><box><size>0.8 0.8 0.02</size></box></geometry>
        <material><ambient>0.35 0.27 0.18 1</ambient><diffuse>0.45 0.33 0.2 1</diffuse></material></visual>
    </link></model>

    <!-- tray = place target on the table -->
    <model name="tray"><static>true</static><pose>0.55 0.0 0.415 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.34 0.34 0.01</size></box></geometry><surface><friction>
        <!-- LOW friction so an off-centre finger can SLIDE the cup toward the pinch
             centre. With the support gripping as hard as the fingers, the cup braced
             against the table and the contact back-drove the closing finger outward
             (fingers ended at 0.041-0.042 on a 0.022 close). bullet combines pair
             friction by multiplication: cup(3.0) x table(0.4) = 1.2 support grip vs
             cup(3.0) x finger(1.0 default) = 3.0 finger grip. -->
        <bullet><friction>0.4</friction><friction2>0.4</friction2></bullet>
      </friction></surface></collision>
      <visual name="v"><geometry><box><size>0.34 0.34 0.01</size></box></geometry>
        <material><ambient>0.1 0.1 0.5 1</ambient><diffuse>0.15 0.15 0.7 1</diffuse></material></visual>
    </link></model>

    <!-- cup (short cylinder) on the table.
         r=0.020 (40 mm), not 25: the simulated jaw is MEASURABLY ~17 mm narrower than
         nominal (finger closes register contact at joint 0.0335 on a 50 mm object =
         8.5 mm early per finger; fat collision pads and/or engine contact margin).
         With a 50 mm cup every clearance sat inside that inflation and a few mm of
         lateral landing error let one finger's contact field shove the cup or get
         back-driven (see AUDIT Phase 1.8). 40 mm restores real clearance: open 0.042
         = 13.5 mm/side free; contact lands at joint ~0.028, mid grasp-gate band. -->
    <!-- z=0.445 rests the cup flat ON the table (table top 0.410 + half-height 0.035);
         it was 0.455, floating 1 cm. y=0.20 is clear of the tray edge (0.17) and stays
         within the arm's precise reach (y=0.24 missed by 42 mm). -->
    <model name="cup"><pose>0.45 0.20 0.445 0 0 0</pose><link name="link">
      <inertial><mass>0.05</mass><inertia><ixx>5e-5</ixx><iyy>5e-5</iyy><izz>5e-5</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.020</radius><length>0.07</length></cylinder></geometry>
        <surface><friction>
          <!-- bullet-featherstone reads ONLY the <bullet> friction tags (and
               <torsional>); the previous <ode><mu> tags were a SILENT NO-OP: the
               plugin never parses them (verified in gz-physics SDFFeatures.cc), so
               every run so far used default friction. Torsional matters for a
               cylinder: without it the cup spins out of a two-point pinch. -->
          <bullet><friction>3.0</friction><friction2>3.0</friction2>
            <rolling_friction>0.1</rolling_friction></bullet>
          <torsional><coefficient>1.0</coefficient></torsional>
        </friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.020</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
    </link></model>

    <!-- second cup, mirrored: flat on the table (z=0.445), y=-0.20 clears the tray
         edge (its old 0.48,-0.18 straddled the edge so bullet toppled it) and mirrors
         cup_1's proven-reachable position. -->
    <model name="cup2"><pose>0.45 -0.20 0.445 0 0 0</pose><link name="link">
      <inertial><mass>0.05</mass><inertia><ixx>5e-5</ixx><iyy>5e-5</iyy><izz>5e-5</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.020</radius><length>0.07</length></cylinder></geometry>
        <surface><friction>
          <!-- bullet-featherstone reads ONLY the <bullet> friction tags (and
               <torsional>); the previous <ode><mu> tags were a SILENT NO-OP: the
               plugin never parses them (verified in gz-physics SDFFeatures.cc), so
               every run so far used default friction. Torsional matters for a
               cylinder: without it the cup spins out of a two-point pinch. -->
          <bullet><friction>3.0</friction><friction2>3.0</friction2>
            <rolling_friction>0.1</rolling_friction></bullet>
          <torsional><coefficient>1.0</coefficient></torsional>
        </friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.020</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.1 0.5 0.85 1</ambient><diffuse>0.1 0.55 0.9 1</diffuse></material></visual>
    </link></model>
  </world>
</sdf>
