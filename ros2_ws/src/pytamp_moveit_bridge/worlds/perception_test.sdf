<?xml version="1.0"?>
<!-- Standalone perception test: an RGBD camera viewing a few objects, to check
     what YOLOv8-COCO detects in Gazebo before wiring perception into the robot. -->
<sdf version="1.8">
  <world name="perc">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse><specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <light type="point" name="fill"><pose>0.5 0 1.2 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse><attenuation><range>5</range></attenuation></light>

    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="c"><geometry><plane><normal>0 0 1</normal></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
    </link></model>

    <!-- Candidate COCO objects on the ground (z so they rest on floor) -->
    <model name="ball"><pose>0.5 -0.15 0.06 0 0 0</pose><link name="link">
      <inertial><mass>0.1</mass><inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><sphere><radius>0.06</radius></sphere></geometry></collision>
      <visual name="v"><geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>1.0 0.55 0.1 1</diffuse></material></visual>
    </link></model>

    <model name="bottle"><pose>0.5 0.05 0.10 0 0 0</pose><link name="link">
      <inertial><mass>0.1</mass><inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.035</radius><length>0.20</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.035</radius><length>0.20</length></cylinder></geometry>
        <material><ambient>0.1 0.5 0.8 1</ambient><diffuse>0.1 0.55 0.85 1</diffuse></material></visual>
    </link></model>

    <model name="cup"><pose>0.5 0.22 0.05 0 0 0</pose><link name="link">
      <inertial><mass>0.05</mass><inertia><ixx>5e-5</ixx><iyy>5e-5</iyy><izz>5e-5</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.04</radius><length>0.10</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
    </link></model>

    <!-- RGBD camera at an angle (behind+above, looking forward-down ~35deg) so
         upright objects show their recognizable profile to YOLO-COCO. -->
    <model name="rgbd_cam"><static>true</static><pose>0.0 0 0.55 0 0.6 0</pose>
      <link name="link">
        <sensor name="rgbd" type="rgbd_camera">
          <update_rate>15</update_rate>
          <topic>camera</topic>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>10.0</far></clip>
            <optical_frame_id>camera_optical</optical_frame_id>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
